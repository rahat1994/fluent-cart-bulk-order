{
    "name": "rahat1994/fluent-cart-bulk-order",
    "description": "Bulk and wholesale ordering for FluentCart stores.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload-dev": {
        "psr-4": {
            "FluentCartBulkOrder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "check": "bin/plugin-check.sh",
        "build": "bin/build-zip.sh"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4"
        }
    }
}
